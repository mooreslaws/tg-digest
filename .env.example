# tg-digest — environment template
#
# Copy to .env (gitignored) and fill in. Most variables are optional —
# only the four marked Required have to be set for a basic local run.

# ── Required ───────────────────────────────────────────────────────────────────

# Get from https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# OpenAI key with access to the chat completions API
OPENAI_API_KEY=

# ── Telegram session (one of these) ────────────────────────────────────────────

# (a) Default: a local .session file created by `python -m tg_digest.auth`.
#     Override the path here if you want it somewhere else.
# TELEGRAM_SESSION=./telegram.session

# (b) For CI / GitHub Actions: a Telethon StringSession dump.
#     `python -m tg_digest.auth` prints this at the end of a successful login.
#     ⚠️  Treat this string like a password — anyone with it can read your messages.
# TELEGRAM_SESSION_STRING=

# ── Output adapters ────────────────────────────────────────────────────────────
# At least one adapter must be configured. By default a local Markdown file is
# always written; set TG_DIGEST_NO_LOCAL=1 to disable that and rely solely on
# Notion / stdout / a custom adapter.

# Local file output — default path. Placeholders: {date} {year} {month} {day} {title}
# TG_DIGEST_OUTPUT_PATH=./reports/digest_{date}.md

# Optional YAML frontmatter prepended to the Markdown (JSON). Useful for
# Obsidian Dataview, Hugo, Jekyll, Eleventy, etc.
# TG_DIGEST_FRONTMATTER={"tags":["digest","telegram"],"date":"{date}"}

# Up to two additional file outputs — handy for "local archive + Obsidian vault".
# TG_DIGEST_OUTPUT_PATH_2=~/Vault/Telegram/digest_{date}.md
# TG_DIGEST_FRONTMATTER_2={"type":"digest","aliases":["TG {date}"]}
# TG_DIGEST_OUTPUT_PATH_3=
# TG_DIGEST_FRONTMATTER_3=

# Disable default local file output:
# TG_DIGEST_NO_LOCAL=1

# Also print the digest to stdout (useful for piping to mail/grep/etc.):
# TG_DIGEST_STDOUT=1

# Register third-party adapters: comma-separated "module:ClassName" refs.
# TG_DIGEST_EXTRA_OUTPUTS=my_outputs:WebhookOutput,another_pkg:S3Output

# ── Notion adapter (optional) ──────────────────────────────────────────────────
# Only active when BOTH NOTION_TOKEN and NOTION_NOTES_DB_ID are set.

# NOTION_TOKEN=secret_...
# NOTION_NOTES_DB_ID=
# NOTION_TITLE_PROP=Title          # name of the title column in your DB
# NOTION_SUMMARY_PROP=             # optional rich_text column for one-line summary
# NOTION_TOPICS_RELATION_PROP=     # optional relation column to a Topics DB
# NOTION_TOPICS_DB_ID=             # required for --detect-topics

# ── Prompts & language ─────────────────────────────────────────────────────────

# TG_DIGEST_LANG=en                # en (default) | ru
# TG_DIGEST_SYSTEM_PROMPT_FILE=    # overrides built-in system prompt
# TG_DIGEST_STRUCTURED_PROMPT_FILE= # overrides built-in structured-mode prompt

# ── Misc knobs (all optional) ──────────────────────────────────────────────────

# OPENAI_CHAT_MODEL=gpt-4o-mini
# TG_DIGEST_DATE_TZ=Europe/Berlin
# TG_DIGEST_INCLUDE_IMAGES=0
# TG_DIGEST_CHANNELS_CONFIG=./channels.yaml
# TG_DIGEST_DAYS=2
# TG_DIGEST_CHANNELS_PER_CHUNK=20
# TG_DIGEST_OPENAI_TIMEOUT_SEC=420
# TG_DIGEST_OPENAI_RETRIES=3
# TG_DIGEST_IMAGES_DIR=./.tg_digest_images
